{
    "name": "C Snake Game",
    "build": {
        "dockerfile": "Dockerfile",
        "context": ".."
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "xaver.clang-format",
                "ms-vscode.cmake-tools"
            ],
            "settings": {
                "cmake.generator": "Ninja",
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.arguments": [
                    "--background-index",
                    "--clang-tidy",
                    "--completion-style=detailed"
                ]
            }
        }
    },
    "remoteUser": "root"
}